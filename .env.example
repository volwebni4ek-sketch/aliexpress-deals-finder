# Provider: "web" (no API key needed), "rapidapi", "official", or "mock"
AE_PROVIDER=web

# Localization defaults
AE_SHIP_TO_COUNTRY=UA
AE_CURRENCY=USD
AE_LANGUAGE=en_US

# SQLite database path for price history & promo monitoring
AE_DB_PATH=deals.db

# Optional: RapidAPI key (free tier on RapidAPI, if using AE_PROVIDER=rapidapi)
AE_RAPIDAPI_KEY=
AE_RAPIDAPI_HOST=aliexpress-scraper-api1.p.rapidapi.com

# Optional: AliExpress Open Platform credentials (if using AE_PROVIDER=official)
AE_APP_KEY=
AE_APP_SECRET=
AE_TRACKING_ID=
